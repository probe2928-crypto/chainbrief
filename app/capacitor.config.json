{
  "appId": "com.chainbrief.app",
  "appName": "체인브리프",
  "webDir": "www",
  "backgroundColor": "#0A0A0A",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#0A0A0A",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0A",
      "overlaysWebView": false
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A0A0A",
    "scrollEnabled": true
  },
  "android": {
    "backgroundColor": "#0A0A0A",
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  }
}