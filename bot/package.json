{
  "name": "chainbrief-signals",
  "private": true,
  "description": "체인브리프 시그널 — 펀딩비·청산·고래·김프 텔레그램 알림봇 + 유료 구독",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "test": "node --no-warnings test/run.mjs && node --no-warnings test/subs.mjs",
    "local": "node local/run.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "cloudflare": {
    "bindings": {
      "TELEGRAM_BOT_TOKEN": {
        "description": "텔레그램 @BotFather → /newbot 으로 만든 봇의 토큰"
      },
      "TG_CHANNEL_KO": {
        "description": "무료 공개 채널(한국어) 아이디, 예: @chainbrief_signals — 봇을 관리자로 추가"
      },
      "TG_CHANNEL_EN": {
        "description": "무료 공개 채널(영어) 아이디, 예: @chainbrief_signals_en"
      },
      "TG_PRO_KO": {
        "description": "(선택) 프로 비공개 채널(한국어) 숫자 ID -100… — 비우면 프로 알림은 봇 대화로"
      },
      "TG_PRO_EN": {
        "description": "(선택) 프로 비공개 채널(영어) 숫자 ID -100…"
      },
      "PAY_TRON_ADDRESS": {
        "description": "구독 결제를 받을 USDT TRC20 주소 (본인 지갑). 비우면 결제 없이 무료 모드"
      },
      "PRICE_MONTH": {
        "description": "1개월 요금 (USDT)"
      },
      "PRICE_QUARTER": {
        "description": "3개월 요금 (USDT)"
      },
      "FREE_DELAY_MIN": {
        "description": "무료 채널 지연 (분)"
      }
    }
  }
}
